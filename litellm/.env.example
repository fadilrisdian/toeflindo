# ─────────────────────────────────────────────────────────────
# toeflindo — LiteLLM proxy environment variables
# Copy to litellm/.env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── LiteLLM master key ────────────────────────────────────────
# Must match LITELLM_MASTER_KEY in the root .env
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master_key

# ── LiteLLM UI password (dashboard at :4000/ui) ───────────────
UI_PASSWORD=CHANGE_ME_ui_password

# ── Postgres (matches the postgres service in docker-compose) ─
LITELLM_DB_PASSWORD=CHANGE_ME_db_password

# ── LLM provider API keys ─────────────────────────────────────
# Groq — used for gpt-oss-*, qwen*, and whisper-large-v3
GROQ_API_KEY=gsk_CHANGE_ME

# OpenRouter — used for gemma-4, hy3, nemotron free-tier models
OPENROUTER_API_KEY=sk-or-CHANGE_ME
