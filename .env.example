# ─────────────────────────────────────────────────────────────
# toeflindo — main environment variables
# Copy to .env and fill in real values.
# Generate SECRET_KEY with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── Auth (REQUIRED — app refuses to start without these) ─────
AUTH_USER=fadil
AUTH_PASS=CHANGE_ME_strong_password_here
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
SESSION_EXPIRE_HOURS=8

# Set to 1 in production to enable secure=True on auth cookie (requires HTTPS)
IS_PRODUCTION=0

# ── LiteLLM proxy ─────────────────────────────────────────────
# Must match the master key in litellm/.env
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master_key
LITELLM_PROXY_URL=http://toefl-litellm:4000

# ── Database paths (defaults work with docker-compose volumes) ─
# TOEFL_DB_PATH=/data/toefl.db
# GRAMMAR_CONTENT_DB_PATH=/data/grammar_content.db
# LESSON_PROMPT_PATH=/data/grammar-lesson-prompt.md

# ── Audio (default works with docker-compose volume mount) ─────
# AUDIO_MOUNT_PREFIX=/audio/

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://toeflindo.site
