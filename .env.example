# Copy this to .env and fill in real values.
# Generate SECRET_KEY with: openssl rand -hex 32
# The following are also used from ../litellm/.env (shared with v1):
#   GROQ_API_KEY, CEREBRAS_API_KEY, LITELLM_MASTER_KEY

# Auth — REQUIRED, no defaults. App will refuse to start without these.
AUTH_USER=fadil
AUTH_PASS=CHANGE_ME_strong_password_here
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
SESSION_EXPIRE_HOURS=8

# Set to 1 in production to enable secure=True on the auth cookie (requires HTTPS)
IS_PRODUCTION=0

# LiteLLM proxy
LITELLM_MASTER_KEY=

# Postgres (for litellm proxy DB — matches ../litellm's postgres)
LITELLM_DB_PASSWORD=litellm
